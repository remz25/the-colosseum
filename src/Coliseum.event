// COLISEUM installer: everything COLISEUM adds to the ROM.
// Included from ROMBuildfile.event (free space section, after the engine hacks).
//
// build/Coliseum.lyn.event is generated by scripts/build.py from src/**/*.c
// (arm-none-eabi-gcc + lyn against the FE-CLib reference). The run-state save chunks are
// declared in EngineHacks/Necessary/ExpandedModularSave/ExModularSave.event.

#ifndef COLISEUM_INSTALLER
#define COLISEUM_INSTALLER

ALIGN 4
#include "../build/Coliseum.lyn.event"

#endif // COLISEUM_INSTALLER
