BYTE 0 0 0 0 0 0                // terminator
ALIGN 4

// The "learn a skill" menu (src/skills/skill_ui.c), run by Col_OfferSkill.
ALIGN 4
ColEvt_SkillOffer:
ASMC Col_StartSkillOffer|1
NoFade
ENDA

// Normal enemies (spec 32): every normal enemy is generic character 0x80, whose level-up skill
// list (CharacterLevelUpSkillEditor.csv) is this one; generics read it by level, together with
// their class list (class skills at level 1). Enemy levels rise ~5 per floor (battle.c), so
// floor 2 enemies get the first skill, floor 3 the second, floor 4 the third. Phase 16 lever.
ALIGN 4
ColEnemySkillList:
BYTE 10 DuelistsBlowID
BYTE 16 VantageID
BYTE 22 LunaID
BYTE 0 0
ALIGN 4
