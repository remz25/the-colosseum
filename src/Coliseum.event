// COLISEUM installer: everything COLISEUM adds to the ROM.
// Included from ROMBuildfile.event (free space section, after the engine hacks).
//
// build/Coliseum.lyn.event is generated by scripts/build.py from src/**/*.c
// (arm-none-eabi-gcc + lyn against the FE-CLib reference). The run-state save chunks are
// declared in EngineHacks/Necessary/ExpandedModularSave/ExModularSave.event.

#ifndef COLISEUM_INSTALLER
#define COLISEUM_INSTALLER

ALIGN 4
#include "../build/Coliseum.lyn.event"

// Portraits (scripts/portraits.py from src/graphics/portraits/Portraits.txt)
#include "../build/Portraits.event"

// Character battle palettes (scripts/charpal.py from src/graphics/battle_palettes.txt)
#include "../build/CharPalettes.event"

// The reusable battle chapter (chapter slot 0)
#include "battle/BattleChapter.event"
#include "battle/SkipWorldMap.event"

// Units: no stat caps, level-up stat choice
#include "units/Units.event"

// Roster: new run, recruitment, deployment, end of a run
#include "roster/Roster.event"

// Skills: 1 personal + 3 slots, catalog (rarity, prerequisites)
#include "skills/Skills.event"

#endif // COLISEUM_INSTALLER
