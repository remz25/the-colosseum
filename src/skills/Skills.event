// Epic
ColSkill(AstraID,        4, 1, 0, 5, 12)
ColSkill(ColossusID,     4, 4, 0, 2, 12)
ColSkill(GaleforceID,    4, 0, 1, 5, 15)
ColSkill(BaneID,         4, 0, 0, 0, 0)
ColSkill(IgnisID,        4, 0, 0, 0, 0)
